# Generation of the configuration file that is installed for a pinned alpaka package.
#
# This file is used while configuring the installation only. The generated file is installed
# next to alpakaConfig.cmake and is evaluated by it before alpakaCommon.cmake is included.

function(_alpaka_install_config_call output variable value type)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\${" "\\\${" value "${value}")
    file(APPEND "${output}" "_alpaka_pin_variable(${variable} \"${value}\" ${type})\n")
endfunction()

function(_alpaka_install_config_compiler output variable value language)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\${" "\\\${" value "${value}")
    file(APPEND "${output}" "_alpaka_pin_compiler(${variable} \"${value}\" ${language})\n")
endfunction()

function(alpaka_generate_install_config output)
    file(WRITE "${output}" "# Generated by the alpaka installation. Do not edit.\n")
    file(APPEND "${output}" "set(alpaka_CONFIG_PINNED ON)\n")
    if(alpaka_INSTALL_ACCELERATOR_PIN)
        file(APPEND "${output}" "set(alpaka_CONFIG_ACCELERATOR_PINNED ON)\n")
    else()
        file(APPEND "${output}" "set(alpaka_CONFIG_ACCELERATOR_PINNED OFF)\n")
    endif()

    file(
        APPEND
        "${output}"
        [=[
# Pin a variable to the value selected while alpaka was installed. A consumer may repeat the
# same value, but it may not broaden or otherwise change the selection.
function(_alpaka_pin_variable variable expected type)
    if(DEFINED ${variable})
        if(NOT "${${variable}}" STREQUAL "${expected}")
            message(
                FATAL_ERROR
                "alpaka was installed with ${variable}=${expected}, but the current configuration requests "
                "${variable}=${${variable}}. Remove the conflicting setting or use a different alpaka "
                "installation."
            )
        endif()
    else()
        set(${variable} "${expected}" CACHE ${type} "Pinned by the alpaka installation" FORCE)
        set(${variable} "${expected}" PARENT_SCOPE)
    endif()
endfunction()

# Pin a compiler before the corresponding language is enabled. CMake cannot replace a compiler
# after a language has been enabled, therefore a conflicting value is always a configuration error.
function(_alpaka_pin_compiler variable expected language)
    if(DEFINED ${variable})
        file(REAL_PATH "${${variable}}" _alpaka_actual_compiler)
        file(REAL_PATH "${expected}" _alpaka_expected_compiler)
        if(NOT _alpaka_actual_compiler STREQUAL _alpaka_expected_compiler)
            if(CMAKE_${language}_COMPILER_LOADED)
                message(
                    FATAL_ERROR
                    "alpaka was installed with the ${language} compiler '${expected}', but the ${language} "
                    "language is already enabled with '${${variable}}'. CMake cannot switch compilers after "
                    "a language has been enabled. Configure the consumer with the matching compiler or use "
                    "a generic alpaka installation."
                )
            endif()
            message(
                FATAL_ERROR
                "alpaka was installed with the ${language} compiler '${expected}', but the current "
                "configuration sets ${variable}='${${variable}}'. Remove the conflicting setting or use a "
                "different alpaka installation."
            )
        endif()
    else()
        set(${variable} "${expected}" CACHE FILEPATH "Pinned by the alpaka installation" FORCE)
        set(${variable} "${expected}" PARENT_SCOPE)
    endif()
endfunction()
]=]
    )

    file(APPEND "${output}" "\n# Host configuration selected at install time.\n")
    _alpaka_install_config_call("${output}" alpaka_DEP_OMP "${alpaka_DEP_OMP}" BOOL)
    _alpaka_install_config_call("${output}" alpaka_DEP_HWLOC "${alpaka_DEP_HWLOC}" STRING)

    set(_alpaka_hwloc_prefix "")
    if(NOT alpaka_DEP_HWLOC STREQUAL "OFF")
        set(_alpaka_hwloc_prefix "${alpaka_INSTALL_HWLOC_PREFIX}")
        if(NOT _alpaka_hwloc_prefix AND DEFINED HWLOC_PREFIX AND HWLOC_PREFIX)
            set(_alpaka_hwloc_prefix "${HWLOC_PREFIX}")
        endif()
        if(NOT _alpaka_hwloc_prefix AND DEFINED HWLOC_INCLUDE_DIRS AND HWLOC_INCLUDE_DIRS)
            list(GET HWLOC_INCLUDE_DIRS 0 _alpaka_hwloc_include_dir)
            get_filename_component(_alpaka_hwloc_prefix "${_alpaka_hwloc_include_dir}" DIRECTORY)
        endif()
        if(NOT _alpaka_hwloc_prefix AND DEFINED HWLOC_LIBRARY_DIRS AND HWLOC_LIBRARY_DIRS)
            list(GET HWLOC_LIBRARY_DIRS 0 _alpaka_hwloc_library_dir)
            get_filename_component(_alpaka_hwloc_prefix "${_alpaka_hwloc_library_dir}" DIRECTORY)
        endif()
    endif()

    if(_alpaka_hwloc_prefix)
        file(REAL_PATH "${_alpaka_hwloc_prefix}" _alpaka_hwloc_prefix)
        _alpaka_install_config_call("${output}" alpaka_PINNED_HWLOC_PREFIX "${_alpaka_hwloc_prefix}" PATH)
        file(APPEND "${output}" "list(PREPEND CMAKE_PREFIX_PATH \"${_alpaka_hwloc_prefix}\")\n")

        set(_alpaka_hwloc_pkgconfig_dir "${_alpaka_hwloc_prefix}/lib/pkgconfig")
        if(NOT EXISTS "${_alpaka_hwloc_pkgconfig_dir}")
            set(_alpaka_hwloc_pkgconfig_dir "${_alpaka_hwloc_prefix}/lib64/pkgconfig")
        endif()
        if(EXISTS "${_alpaka_hwloc_pkgconfig_dir}")
            string(REPLACE "\\" "\\\\" _alpaka_hwloc_pkgconfig_dir "${_alpaka_hwloc_pkgconfig_dir}")
            string(REPLACE "\"" "\\\"" _alpaka_hwloc_pkgconfig_dir "${_alpaka_hwloc_pkgconfig_dir}")
            file(
                APPEND
                "${output}"
                "set(ENV{PKG_CONFIG_PATH} \"${_alpaka_hwloc_pkgconfig_dir}:\$ENV{PKG_CONFIG_PATH}\")\n"
            )
        endif()
    endif()

    if(alpaka_INSTALL_ACCELERATOR_PIN)
        file(APPEND "${output}" "\n# Accelerator APIs selected at install time.\n")
        _alpaka_install_config_call("${output}" alpaka_DEP_CUDA "${alpaka_DEP_CUDA}" BOOL)
        _alpaka_install_config_call("${output}" alpaka_DEP_HIP "${alpaka_DEP_HIP}" BOOL)
        _alpaka_install_config_call("${output}" alpaka_DEP_ONEAPI "${alpaka_DEP_ONEAPI}" BOOL)

        if(alpaka_DEP_CUDA)
            if(NOT CMAKE_CUDA_COMPILER)
                message(FATAL_ERROR "CUDA is pinned but CMake did not enable the CUDA language.")
            endif()

            # Preserve the compiler path as given. Resolving symlinks can lose the driver name
            # (for example the AMD clang multiplexer) and break language detection in consumers.
            set(_alpaka_cuda_compiler "${CMAKE_CUDA_COMPILER}")
            if(alpaka_INSTALL_CUDA_COMPILER)
                file(REAL_PATH "${alpaka_INSTALL_CUDA_COMPILER}" _alpaka_requested_cuda_compiler)
                file(REAL_PATH "${CMAKE_CUDA_COMPILER}" _alpaka_actual_cuda_compiler)
                if(NOT _alpaka_requested_cuda_compiler STREQUAL _alpaka_actual_cuda_compiler)
                    message(
                        FATAL_ERROR
                        "CUDA compiler '${_alpaka_requested_cuda_compiler}' was requested, but CMake used "
                        "'${_alpaka_actual_cuda_compiler}'."
                    )
                endif()
            endif()
            _alpaka_install_config_compiler("${output}" CMAKE_CUDA_COMPILER "${_alpaka_cuda_compiler}" CUDA)
            file(APPEND "${output}" "set(alpaka_PINNED_CUDA_COMPILER_ID \"${CMAKE_CUDA_COMPILER_ID}\")\n")

            set(_alpaka_cuda_toolkit_root "${alpaka_INSTALL_CUDA_TOOLKIT_ROOT}")
            if(NOT _alpaka_cuda_toolkit_root AND DEFINED CUDAToolkit_ROOT)
                set(_alpaka_cuda_toolkit_root "${CUDAToolkit_ROOT}")
            endif()
            if(NOT _alpaka_cuda_toolkit_root AND DEFINED CMAKE_CUDA_COMPILER_TOOLKIT_ROOT)
                set(_alpaka_cuda_toolkit_root "${CMAKE_CUDA_COMPILER_TOOLKIT_ROOT}")
            endif()
            if(_alpaka_cuda_toolkit_root)
                file(REAL_PATH "${_alpaka_cuda_toolkit_root}" _alpaka_cuda_toolkit_root)
                _alpaka_install_config_call(
                    "${output}"
                    CUDAToolkit_ROOT
                    "${_alpaka_cuda_toolkit_root}"
                    PATH
                )
                file(APPEND "${output}" "list(PREPEND CMAKE_PREFIX_PATH \"${_alpaka_cuda_toolkit_root}\")\n")
            elseif(CMAKE_CUDA_COMPILER_ID STREQUAL "Clang")
                message(
                    FATAL_ERROR
                    "A Clang CUDA installation requires a CUDA toolkit root. Set "
                    "alpaka_INSTALL_CUDA_TOOLKIT_ROOT."
                )
            endif()

            if(alpaka_INSTALL_CUDA_ARCHITECTURES)
                _alpaka_install_config_call(
                    "${output}"
                    CMAKE_CUDA_ARCHITECTURES
                    "${alpaka_INSTALL_CUDA_ARCHITECTURES}"
                    STRING
                )
            endif()
        endif()

        if(alpaka_DEP_HIP)
            if(NOT CMAKE_HIP_COMPILER)
                message(FATAL_ERROR "HIP is pinned but CMake did not enable the HIP language.")
            endif()

            set(_alpaka_hip_compiler "${CMAKE_HIP_COMPILER}")
            if(alpaka_INSTALL_HIP_COMPILER)
                file(REAL_PATH "${alpaka_INSTALL_HIP_COMPILER}" _alpaka_requested_hip_compiler)
                file(REAL_PATH "${CMAKE_HIP_COMPILER}" _alpaka_actual_hip_compiler)
                if(NOT _alpaka_requested_hip_compiler STREQUAL _alpaka_actual_hip_compiler)
                    message(
                        FATAL_ERROR
                        "HIP compiler '${_alpaka_requested_hip_compiler}' was requested, but CMake used "
                        "'${_alpaka_actual_hip_compiler}'."
                    )
                endif()
            endif()
            _alpaka_install_config_compiler("${output}" CMAKE_HIP_COMPILER "${_alpaka_hip_compiler}" HIP)

            if(DEFINED hip_DIR AND hip_DIR)
                file(REAL_PATH "${hip_DIR}" _alpaka_hip_dir)
                _alpaka_install_config_call("${output}" hip_DIR "${_alpaka_hip_dir}" PATH)
                get_filename_component(_alpaka_hip_root "${_alpaka_hip_dir}/../../.." ABSOLUTE)
                _alpaka_install_config_call("${output}" ROCM_PATH "${_alpaka_hip_root}" PATH)
                _alpaka_install_config_call("${output}" HIP_PATH "${_alpaka_hip_root}" PATH)
                file(APPEND "${output}" "list(PREPEND CMAKE_PREFIX_PATH \"${_alpaka_hip_root}\")\n")
            endif()

            if(alpaka_INSTALL_HIP_ARCHITECTURES)
                _alpaka_install_config_call(
                    "${output}"
                    CMAKE_HIP_ARCHITECTURES
                    "${alpaka_INSTALL_HIP_ARCHITECTURES}"
                    STRING
                )
            endif()
        endif()

        if(alpaka_DEP_ONEAPI)
            if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "IntelLLVM")
                message(
                    FATAL_ERROR
                    "oneAPI is pinned but the CXX compiler is '${CMAKE_CXX_COMPILER_ID}'. "
                    "Configure the installation with the IntelLLVM compiler (icpx)."
                )
            endif()

            set(_alpaka_oneapi_compiler "${CMAKE_CXX_COMPILER}")
            if(alpaka_INSTALL_ONEAPI_COMPILER)
                file(REAL_PATH "${alpaka_INSTALL_ONEAPI_COMPILER}" _alpaka_requested_oneapi_compiler)
                file(REAL_PATH "${CMAKE_CXX_COMPILER}" _alpaka_actual_oneapi_compiler)
                if(NOT _alpaka_requested_oneapi_compiler STREQUAL _alpaka_actual_oneapi_compiler)
                    message(
                        FATAL_ERROR
                        "oneAPI compiler '${_alpaka_requested_oneapi_compiler}' was requested, but CMake used "
                        "'${_alpaka_actual_oneapi_compiler}'."
                    )
                endif()
            endif()
            _alpaka_install_config_compiler("${output}" CMAKE_CXX_COMPILER "${_alpaka_oneapi_compiler}" CXX)

            if(DEFINED IntelSYCL_DIR AND IntelSYCL_DIR)
                _alpaka_install_config_call("${output}" IntelSYCL_DIR "${IntelSYCL_DIR}" PATH)
            else()
                message(
                    FATAL_ERROR
                    "oneAPI is pinned but IntelSYCL_DIR is not set. The IntelSYCL CMake package is required."
                )
            endif()

            get_filename_component(_alpaka_oneapi_bin "${_alpaka_oneapi_compiler}" DIRECTORY)
            get_filename_component(_alpaka_oneapi_prefix "${_alpaka_oneapi_bin}" DIRECTORY)
            file(APPEND "${output}" "list(PREPEND CMAKE_PREFIX_PATH \"${_alpaka_oneapi_prefix}\")\n")
        endif()
    endif()
endfunction()
