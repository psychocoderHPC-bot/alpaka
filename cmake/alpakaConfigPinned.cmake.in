# Generated by the alpaka installation. Do not edit.
set(alpaka_CONFIG_PINNED ON)
set(alpaka_CONFIG_ACCELERATOR_PINNED @ALPAKA_PIN_ACCELERATOR@)

# Pin a variable to the value selected while alpaka was installed. A consumer may repeat the
# same value, but it may not broaden or otherwise change the selection.
function(_alpaka_pin_variable variable expected type)
    if(DEFINED ${variable})
        if(NOT "${${variable}}" STREQUAL "${expected}")
            message(
                FATAL_ERROR
                "alpaka was installed with ${variable}=${expected}, but the current configuration requests "
                "${variable}=${${variable}}. Remove the conflicting setting or use a different alpaka "
                "installation."
            )
        endif()
    else()
        set(${variable} "${expected}" CACHE ${type} "Pinned by the alpaka installation" FORCE)
        set(${variable} "${expected}" PARENT_SCOPE)
    endif()
endfunction()

# Pin a compiler before the corresponding language is enabled. CMake cannot replace a compiler
# after a language has been enabled, therefore a conflicting value is always a configuration error.
function(_alpaka_pin_compiler variable expected language)
    if(DEFINED ${variable})
        file(REAL_PATH "${${variable}}" _alpaka_actual_compiler)
        file(REAL_PATH "${expected}" _alpaka_expected_compiler)
        if(NOT _alpaka_actual_compiler STREQUAL _alpaka_expected_compiler)
            if(CMAKE_${language}_COMPILER_LOADED)
                message(
                    FATAL_ERROR
                    "alpaka was installed with the ${language} compiler '${expected}', but the ${language} "
                    "language is already enabled with '${${variable}}'. CMake cannot switch compilers after "
                    "a language has been enabled. Configure the consumer with the matching compiler or use "
                    "a generic alpaka installation."
                )
            endif()
            message(
                FATAL_ERROR
                "alpaka was installed with the ${language} compiler '${expected}', but the current "
                "configuration sets ${variable}='${${variable}}'. Remove the conflicting setting or use a "
                "different alpaka installation."
            )
        endif()
    else()
        set(${variable} "${expected}" CACHE FILEPATH "Pinned by the alpaka installation" FORCE)
        set(${variable} "${expected}" PARENT_SCOPE)
    endif()
endfunction()

# Host configuration selected at install time.
_alpaka_pin_variable(alpaka_DEP_OMP "@ALPAKA_PIN_OMP@" BOOL)
_alpaka_pin_variable(alpaka_DEP_HWLOC "@ALPAKA_PIN_HWLOC@" STRING)

if(NOT "@ALPAKA_PIN_HWLOC_PREFIX@" STREQUAL "")
    set(alpaka_PINNED_HWLOC_PREFIX "@ALPAKA_PIN_HWLOC_PREFIX@")
    list(PREPEND CMAKE_PREFIX_PATH "@ALPAKA_PIN_HWLOC_PREFIX@")
endif()
if(NOT "@ALPAKA_PIN_HWLOC_PKGCONFIG@" STREQUAL "")
    set(ENV{PKG_CONFIG_PATH} "@ALPAKA_PIN_HWLOC_PKGCONFIG@:$ENV{PKG_CONFIG_PATH}")
endif()

if(alpaka_CONFIG_ACCELERATOR_PINNED)
    _alpaka_pin_variable(alpaka_DEP_CUDA "@ALPAKA_PIN_CUDA@" BOOL)
    _alpaka_pin_variable(alpaka_DEP_HIP "@ALPAKA_PIN_HIP@" BOOL)
    _alpaka_pin_variable(alpaka_DEP_ONEAPI "@ALPAKA_PIN_ONEAPI@" BOOL)

    if(alpaka_DEP_CUDA)
        _alpaka_pin_compiler(CMAKE_CUDA_COMPILER "@ALPAKA_PIN_CUDA_COMPILER@" CUDA)
        set(alpaka_PINNED_CUDA_COMPILER_ID "@ALPAKA_PIN_CUDA_COMPILER_ID@")

        if(NOT "@ALPAKA_PIN_CUDA_TOOLKIT_ROOT@" STREQUAL "")
            _alpaka_pin_variable(CUDAToolkit_ROOT "@ALPAKA_PIN_CUDA_TOOLKIT_ROOT@" PATH)
            list(PREPEND CMAKE_PREFIX_PATH "@ALPAKA_PIN_CUDA_TOOLKIT_ROOT@")
        endif()
        if(NOT "@ALPAKA_PIN_CUDA_ARCHITECTURES@" STREQUAL "")
            _alpaka_pin_variable(CMAKE_CUDA_ARCHITECTURES "@ALPAKA_PIN_CUDA_ARCHITECTURES@" STRING)
        endif()
    endif()

    if(alpaka_DEP_HIP)
        _alpaka_pin_compiler(CMAKE_HIP_COMPILER "@ALPAKA_PIN_HIP_COMPILER@" HIP)

        if(NOT "@ALPAKA_PIN_HIP_DIR@" STREQUAL "")
            _alpaka_pin_variable(hip_DIR "@ALPAKA_PIN_HIP_DIR@" PATH)
            _alpaka_pin_variable(ROCM_PATH "@ALPAKA_PIN_HIP_ROOT@" PATH)
            _alpaka_pin_variable(HIP_PATH "@ALPAKA_PIN_HIP_ROOT@" PATH)
            list(PREPEND CMAKE_PREFIX_PATH "@ALPAKA_PIN_HIP_ROOT@")
        endif()
        if(NOT "@ALPAKA_PIN_HIP_ARCHITECTURES@" STREQUAL "")
            _alpaka_pin_variable(CMAKE_HIP_ARCHITECTURES "@ALPAKA_PIN_HIP_ARCHITECTURES@" STRING)
        endif()
    endif()

    if(alpaka_DEP_ONEAPI)
        _alpaka_pin_compiler(CMAKE_CXX_COMPILER "@ALPAKA_PIN_ONEAPI_COMPILER@" CXX)

        if(NOT "@ALPAKA_PIN_ONEAPI_INTELSYCL_DIR@" STREQUAL "")
            _alpaka_pin_variable(IntelSYCL_DIR "@ALPAKA_PIN_ONEAPI_INTELSYCL_DIR@" PATH)
        endif()
        if(NOT "@ALPAKA_PIN_ONEAPI_PREFIX@" STREQUAL "")
            list(PREPEND CMAKE_PREFIX_PATH "@ALPAKA_PIN_ONEAPI_PREFIX@")
        endif()
    endif()
endif()
