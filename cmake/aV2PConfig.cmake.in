@PACKAGE_INIT@

################################################################################
# alpaka.

set(aV2P_DEBUG "0" CACHE STRING "Debug level")
set_property(CACHE aV2P_DEBUG PROPERTY STRINGS "0;1;2")

#-------------------------------------------------------------------------------
# Common.

# This file's directory.
set(_aV2P_ROOT_DIR ${CMAKE_CURRENT_LIST_DIR})
# Normalize the path (e.g. remove ../)
get_filename_component(_aV2P_ROOT_DIR ${_aV2P_ROOT_DIR} ABSOLUTE)

# Compiler feature tests.
set(_aV2P_FEATURE_TESTS_DIR "${_aV2P_ROOT_DIR}/tests")

# Add common functions.
set(_aV2P_COMMON_FILE "${_aV2P_ROOT_DIR}/common.cmake")
include(${_aV2P_COMMON_FILE})

# Add aV2P_ADD_EXECUTABLE function.
set(_aV2P_ADD_EXECUTABLE_FILE "${_aV2P_ROOT_DIR}/addExecutable.cmake")
include(${_aV2P_ADD_EXECUTABLE_FILE})

# Add aV2P_ADD_LIBRARY function.
set(_aV2P_ADD_LIBRARY_FILE "${_aV2P_ROOT_DIR}/addLibrary.cmake")
include(${_aV2P_ADD_LIBRARY_FILE})

# Set found to true initially and set it to false if a required dependency is missing.
set(_aV2P_FOUND TRUE)

set(_aV2P_INCLUDE_DIRECTORY "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_INCLUDEDIR@")

include("${CMAKE_CURRENT_LIST_DIR}/aV2PCommon.cmake")

check_required_components("aV2P")

# Unset already set variables if not found.
if(NOT _aV2P_FOUND)
    unset(_aV2P_FOUND)
    unset(_aV2P_COMPILE_OPTIONS_PUBLIC)
    unset(_aV2P_COMPILE_DEFINITIONS_HIP)
    unset(_aV2P_HIP_LIBRARIES)
    unset(_aV2P_INCLUDE_DIRECTORY)
    unset(_aV2P_ADD_EXECUTABLE_FILE)
    unset(_aV2P_ADD_LIBRARY_FILE)
    unset(_aV2P_BOOST_MIN_VER)
else()
    # Make internal variables advanced options in the GUI.
    mark_as_advanced(
        _aV2P_COMPILE_OPTIONS_PUBLIC
        _aV2P_INCLUDE_DIRECTORY
        _aV2P_COMMON_FILE
        _aV2P_ADD_EXECUTABLE_FILE
        _aV2P_ADD_LIBRARY_FILE
        _aV2P_BOOST_MIN_VER)
endif()
