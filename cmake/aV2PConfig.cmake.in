@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Seed the legacy option cache with the values used to build this aV2P package.
# Entries already set by the consumer are left untouched.
include("${CMAKE_CURRENT_LIST_DIR}/aV2PConfigDefaults.cmake")

# Declare the legacy aV2P 2.2 options and translate them to native alpaka 3
# options before the native package is found. This is the same boundary used
# while building aV2P, so a consumer sees one consistent native configuration.
include("${CMAKE_CURRENT_LIST_DIR}/aV2POptions.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/aV2PNativeOptions.cmake")

# A standalone aV2P install bundles native alpaka 3 in the same prefix.  Prefer that copy so a
# consumer does not have to set alpaka_DIR or add a second prefix to CMAKE_PREFIX_PATH.
if(NOT DEFINED alpaka_DIR
   AND NOT DEFINED alpaka3_DIR
   AND NOT DEFINED aV2P_ALPAKA3_DIR
   AND EXISTS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cmake/alpaka/alpakaConfig.cmake")
    set(alpaka_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cmake/alpaka"
        CACHE PATH "Bundled native alpaka 3 package shipped by aV2P")
endif()

find_dependency(alpaka 3.0.0 CONFIG)
find_dependency(Threads)

# The languages and imported toolkit targets belong to the directory scope in
# which find_package(aV2P) runs. Enable the configured device languages here so
# consumers that call aV2P_finalize() directly see the same environment as the
# aV2P build helpers.
if(aV2P_ACC_GPU_CUDA_ENABLE)
    enable_language(CUDA)
    find_dependency(CUDAToolkit)
endif()
if(aV2P_ACC_GPU_HIP_ENABLE)
    enable_language(HIP)
    find_dependency(hip)
endif()
if("@aV2P_CONFIG_NEEDS_BOOST_ATOMIC@" STREQUAL "ON")
    find_dependency(Boost 1.74.0 CONFIG OPTIONAL_COMPONENTS atomic)
endif()

# aV2P helper functions (unchanged 2.2 signatures).
include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/addExecutable.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/addLibrary.cmake")

# Native alpaka 3 requires targets to be finalized. Include after
# find_dependency(alpaka) so the native helpers are already available.
include("${CMAKE_CURRENT_LIST_DIR}/aV2PFinalize.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/aV2PTargets.cmake")

# The build tree links the native target through a BUILD_INTERFACE expression so
# that the exported target stays free of non-exported build-tree targets.
set_property(TARGET aV2P::aV2P APPEND PROPERTY INTERFACE_LINK_LIBRARIES alpaka::alpaka)

# The build-tree target carries the device backend through a BUILD_INTERFACE
# expression. Restore the same backend after installation so finalize detects
# the device language of consumer targets.
if(aV2P_ACC_GPU_CUDA_ENABLE AND TARGET alpaka::cuda)
    set_property(TARGET aV2P::aV2P APPEND PROPERTY INTERFACE_LINK_LIBRARIES alpaka::cuda)
endif()
if(aV2P_ACC_GPU_HIP_ENABLE AND TARGET alpaka::hip)
    set_property(TARGET aV2P::aV2P APPEND PROPERTY INTERFACE_LINK_LIBRARIES alpaka::hip)
endif()
if(aV2P_ACC_SYCL_ENABLE AND TARGET alpaka::oneapi)
    set_property(TARGET aV2P::aV2P APPEND PROPERTY INTERFACE_LINK_LIBRARIES alpaka::oneapi)
endif()

set(aV2P_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
set(aV2P_INCLUDE_DIRECTORY "${aV2P_INCLUDE_DIR}")

check_required_components(aV2P)
