@PACKAGE_INIT@

#-------------------------------------------------------------------------------
# Common.

# alpaka root directory
set(_alpaka_ROOT_DIR "${PACKAGE_PREFIX_DIR}")
# Compiler feature tests.
set(_alpaka_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")

# Tests, this is required because the used compiler can differ compared to the compiler used for installation.
set(_alpaka_FEATURE_TESTS_DIR "${_alpaka_CMAKE_DIR}/test")
set(_alpaka_TESTS_DIR "@PACKAGE_CMAKE_INSTALL_DATAROOTDIR@/test")

set(_alpaka_INCLUDE_DIRECTORY "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

# A pinned installation records the API and toolchain selection made at install time.
# It must be evaluated before alpakaCommon.cmake enables any language or creates a target.
if(EXISTS "${_alpaka_CMAKE_DIR}/alpakaConfigPinned.cmake")
    include("${_alpaka_CMAKE_DIR}/alpakaConfigPinned.cmake")
endif()

include("${_alpaka_CMAKE_DIR}/alpakaCommon.cmake")

if(
    DEFINED alpaka_CONFIG_ACCELERATOR_PINNED
    AND alpaka_CONFIG_ACCELERATOR_PINNED
    AND DEFINED alpaka_PINNED_CUDA_COMPILER_ID
    AND alpaka_PINNED_CUDA_COMPILER_ID STREQUAL "Clang"
    AND NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang"
)
    message(
        FATAL_ERROR
        "This alpaka installation compiles CUDA device code with Clang. Clang CUDA requires a "
        "Clang host compiler. Configure the consumer with CXX=clang++ or use a different alpaka "
        "installation."
    )
endif()

check_required_components(alpaka)

# CMake Options to activate testing with the currently selected environment
option(alpaka_TESTS "Enable/Disable testing" OFF)

if(alpaka_TESTS)
    include(CTest)
    enable_testing()
    add_subdirectory("${_alpaka_TESTS_DIR}" "${CMAKE_BINARY_DIR}/alpaka/test")
endif()
