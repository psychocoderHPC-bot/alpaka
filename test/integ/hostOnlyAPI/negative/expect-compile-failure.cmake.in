# Generated by aV2P.  Compile a host-only TU that enqueues a CUDA/HIP kernel and require exactly
# the native launch-guard diagnostic.
execute_process(
    COMMAND "@CMAKE_CXX_COMPILER@" -std=c++20 -c
            "@CMAKE_CURRENT_SOURCE_DIR@/negative/hostOnlyKernelLaunch.cpp"
            -o "@CMAKE_CURRENT_BINARY_DIR@/hostOnlyKernelLaunch.o"
            @_aV2P_NEGATIVE_FLAGS@
    RESULT_VARIABLE _result
    OUTPUT_VARIABLE _out
    ERROR_VARIABLE _err)

if(_result EQUAL 0)
    message(FATAL_ERROR
        "aV2P: a host-only translation unit compiled a CUDA/HIP kernel enqueue. "
        "The native launch guard is missing.")
endif()

set(_diag "${_out}${_err}")
if(NOT _diag MATCHES "requires a CUDA/HIP compiler")
    message(FATAL_ERROR
        "aV2P: the host-only kernel enqueue failed without the expected launch-guard diagnostic:\n"
        "${_diag}")
endif()

message(STATUS "aV2P: host-only kernel enqueue rejected by the launch guard")
